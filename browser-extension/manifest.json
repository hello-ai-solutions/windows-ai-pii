{
  "manifest_version": 3,
  "name": "PII Guard",
  "version": "0.1.0",
  "description": "Sanitize AI prompts before send",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://chat.openai.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
